#!/bin/bash
# ==== PJM オプション =========================================
#PJM -g gb20
#PJM -L rscgrp=regular-a
#PJM -L node=1
#PJM -L elapse=08:00:00
#PJM -N akorn_resnet_slim_cifar10_L1T0
#PJM -o logs/%n.%j.out
#PJM -e logs/%n.%j.err
#PJM -j
#PJM -L jobenv=singularity
# =============================================================

module purge
module load singularity

# cd "${PJM_O_WORKDIR:-$PWD}"
cd /work/gb20/b20109/akorn
export PBS_JOBID=$PJM_JOBID

# --- 任意の環境変数 -------------------------------------------------
export REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
export WANDB_API_KEY=ac9bc3f259163957d95686abca5fb49df1713b65
export WANDB_PROJECT=akorn_resnet_slim_cifar10_L1T0
TODAY=$(date '+%Y%m%d')
# ------------------------------------------------------------------

# --- 実行 ----------------------------------------------------------
singularity exec --nv                         \
  --bind "$(pwd)":/workspace                  \
  --bind /etc/pki/tls/certs/ca-bundle.crt:/etc/pki/tls/certs/ca-bundle.crt \
  ~/singularity/akorn_wisteria.sif             \
  python scripts/cifar10_control_noakorn_resnet_classification.py \
      --save-dir "results/${TODAY}_${PJM_JOBID}"       \
      --wandb-project "${WANDB_PROJECT}"               \
      --epochs 30                                      \
      --batch-size 64                                  \
      --lr 1e-4 \
      --n 2 --ch 128 --L 1 --T 0

STATUS=$?   # 0=正常終了

# --- Slack 通知 ----------------------------------------------------
JOB_NAME=$PJM_JOBNAME
JOB_ID=$PJM_JOBID
NODE_NAME=$(hostname)

send_slack () {
  curl -s -X POST -H 'Content-type: application/json' \
       --data "{\"text\":\"$1\"}" "$SLACK_WEBHOOK"
}

if [ "$STATUS" -eq 0 ]; then
  send_slack "✅ *Job Finished Successfully*\n> Job: \`$JOB_NAME\`\n> ID: \`$JOB_ID\`\n> Node: \`$NODE_NAME\`"
else
  send_slack "❌ *Job Failed*\n> Job: \`$JOB_NAME\`\n> ID: \`$JOB_ID\`\n> Node: \`$NODE_NAME\` (exit $STATUS)"
fi
